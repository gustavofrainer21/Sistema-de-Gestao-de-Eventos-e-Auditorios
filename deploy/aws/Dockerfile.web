# Compila o front-end (React) e serve com nginx, que tambem faz proxy de /api e /auth.
FROM node:20-alpine AS build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm install --no-audit --no-fund
COPY frontend/ ./
ARG VITE_KEYCLOAK_URL
ENV VITE_API_URL="" VITE_KEYCLOAK_URL=$VITE_KEYCLOAK_URL VITE_KEYCLOAK_REALM=eventos VITE_KEYCLOAK_CLIENT=eventos-frontend
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/aws/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html
