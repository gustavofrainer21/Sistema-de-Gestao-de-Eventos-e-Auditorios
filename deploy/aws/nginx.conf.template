server {
  listen 80;
  root /usr/share/nginx/html;

  # O HTTPS e terminado pelo API Gateway; o Host publico e fixo (PUBLIC_HOST).
  proxy_set_header Host ${PUBLIC_HOST};
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Forwarded-Host ${PUBLIC_HOST};
  proxy_set_header X-Forwarded-Port 443;
  proxy_buffer_size 16k;
  proxy_buffers 8 16k;

  location /api/ { proxy_pass http://api:8080; }
  location /auth/ { proxy_pass http://keycloak:8080; }
  location / { try_files $uri /index.html; }
}
